{
  "name": "smem-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-public-data.mjs",
    "precheck": "node scripts/ensure-public-data.mjs",
    "build": "tsc -b && vite build && node scripts/check-route-artifacts.mjs",
    "check:public-data": "node scripts/verify-public-snapshot.mjs",
    "check": "tsc -b && npm run check:public-data",
    "test": "vitest run src/lib/route.test.ts scripts/public-freshness.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "^22.20.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "vitest": "^5.0.3"
  }
}
